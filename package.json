{
  "name": "vedio-genspark",
  "version": "2.0.0",
  "description": "TECH-MONSTER | Premium AI News Broadcasting Platform",
  "main": "src/index.mjs",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "newsroom": "node packages/editorial/pipeline.mjs",
    "dashboard": "node packages/dashboard/index.mjs",
    "db:init": "node packages/database/db.mjs",
    "templates": "node packages/editorial/templates.mjs",
    "storage": "node packages/storage/manager.mjs",
    "pipeline": "node scripts/composer.mjs",
    "dev:composer": "node --watch scripts/composer.mjs",
    "worker": "node apps/worker/jobs-worker.mjs",
    "worker:once": "node apps/worker/jobs-worker.mjs --once",
    "dev:hot": "node scripts/dev.mjs",
    "dev:hot-intro": "node scripts/dev.mjs --intro",
    "broadcast": "node src/index.mjs",
    "broadcast:dev": "node --watch src/index.mjs",
    "broadcast:article": "node src/index.mjs",
    "intro": "node scripts/intro.mjs",
    "intro:4k": "node scripts/intro.mjs output --4k",
    "scene:engine": "node src/video/SceneEngine.mjs",
    "quality": "node src/quality/QualityChecker.mjs",
    "ai": "node .github/scripts/ai-helper.mjs",
    "ai:health": "node .github/scripts/ai-helper.mjs health",
    "ai:enhance": "node .github/scripts/ai-helper.mjs enhance",
    "ai:debug": "node .github/scripts/ai-helper.mjs debug",
    "ai:full": "node .github/scripts/ai-helper.mjs full",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "open-graph-scraper": "^6.12.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "uuid": "^10.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-linux-x64-gnu": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  }
}
