{
  "name": "vedio-genspark",
  "version": "1.0.0",
  "description": "Self-hosted video generation stack similar to Genspark AI",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "newsroom": "node packages/editorial/pipeline.mjs",
    "dashboard": "node packages/dashboard/index.mjs",
    "db:init": "node packages/database/db.mjs",
    "templates": "node packages/editorial/templates.mjs",
    "storage": "node packages/storage/manager.mjs",
    "pipeline": "node scripts/composer.mjs",
    "dev:composer": "node --watch scripts/composer.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "open-graph-scraper": "^6.12.0",
    "uuid": "^10.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-linux-x64-gnu": "^1.0.2"
  }
}
