# === REQUIRED ===
# Get free Gemini key (no CC): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# YouTube OAuth (see: https://console.cloud.google.com/apis/credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
