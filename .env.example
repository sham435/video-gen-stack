# NewsAPI (free tier: https://newsapi.org/register)
NEWSAPI_KEY=

# === OPTIONAL ===
PORT=3001
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
