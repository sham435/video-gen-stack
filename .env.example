# === REQUIRED ===
# Get free Gemini key (no CC): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# YouTube OAuth (see: https://console.cloud.google.com/apis/credentials)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public

# NewsAPI (free tier: https://newsapi.org/register)
NEWSAPI_KEY=
# NewsData.io (free tier: https://newsdata.io/) — companion source, used with NEWSAPI_KEY
NEWS_DATA_KEY=

# ElevenLabs (for professional news anchor TTS, free tier available)
# Get key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=N2lVS1w4EtoT3F4G4C2d

# === OPTIONAL ===
PORT=3001
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# LinkedIn Share on LinkedIn (see: https://developer.linkedin.com/)
# Authenticate via GET /api/linkedin/auth (dashboard) — callback writes the
# access token + member URN to .env automatically.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://video-gen-stack-production.up.railway.app/api/auth/linkedin/callback
# Set 1 ONLY after the app is verified and w_organization_social is approved:
LINKEDIN_ORG_SOCIAL=0
LINKEDIN_ORG_ID=
# Set by the OAuth callback:
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_REFRESH_TOKEN=
# LINKEDIN_MEMBER_URN=

# === C2PA Content Credentials ===
# C2PA signing provides verifiable provenance for published thumbnails.
# Development: bundled test certificate auto-installed to ~/.config/news-monster/c2pa/
# Production: set C2PA_CERT_PATH + C2PA_KEY_PATH to your organization-issued certificate.
#
# C2PA_ENABLED=true              # Enable/disable C2PA signing (default: true)
# C2PA_REQUIRED=false            # If true, block publish when signing/verification fails
# C2PA_VERIFY_AFTER_SIGN=true    # Verify the signed artifact immediately after signing
# C2PA_CERT_PATH=                # Path to PEM cert chain (dev: auto-copied from bundled test cert)
# C2PA_KEY_PATH=                 # Path to PEM private key (dev: auto-copied from bundled test cert)
